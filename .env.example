# ログレベル(DEBUG、INFO、WARNING、ERROR)
LOG_LEVEL=INFO

# Discord Botのトークン
DISCORD_BOT_TOKEN=xxxxxxxxxx

# 交換コードの自動チェック間隔(時間)
CHECK_INTERVAL_HOURS=1

# ログファイルの保持日数(これを超えた古いログは自動削除される)
LOG_RETENTION_DAYS=30

# DiscordサーバーID
GUILD_ID=123456789012345678
# 交換コードの自動チェックを行うチャンネルID
GENSHIN_CHANNEL_ID=123456789012345678
STARRAIL_CHANNEL_ID=123456789012345678
ZZZ_CHANNEL_ID=123456789012345678
WUTHERING_CHANNEL_ID=123456789012345678

# 問い合わせ先（ドキュメント用。Bot 本体は未使用）
# ISSUES_URL=https://github.com/oshiiiso/discord-bot-fancode/issues
